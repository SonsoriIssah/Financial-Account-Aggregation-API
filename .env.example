# Copy this file to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/finaggapi
JWT_SECRET_KEY=change-me
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MOCK_PROVIDER_BASE_URL=http://127.0.0.1:9000

# Aggregator provider: mock | plaid
PROVIDER=mock
ENCRYPTION_KEY=ZmFhLWRldi1vbmx5LWZlcm5ldC1rZXktMDAwMDAwMDE=
# only needed when PROVIDER=plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
