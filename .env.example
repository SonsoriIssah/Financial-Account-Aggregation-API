# Copy this file to .env and fill in real values. Never commit .env.
#
# Local / docker compose values shown below. For the hosted deploy (Render +
# Neon + Upstash + Cloudflare Pages), see the "Deployment" section in
# README.md — DATABASE_URL becomes your Neon connection string with
# DB_SSL_REQUIRE=true, REDIS_URL becomes Upstash's rediss:// URL, and
# CORS_ALLOW_ORIGINS becomes your Cloudflare Pages origin.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/finaggapi
DB_SSL_REQUIRE=false
JWT_SECRET_KEY=change-me
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MOCK_PROVIDER_BASE_URL=http://127.0.0.1:9000
CORS_ALLOW_ORIGINS=http://localhost:5173

# Aggregator provider: mock | plaid
PROVIDER=mock
ENCRYPTION_KEY=ZmFhLWRldi1vbmx5LWZlcm5ldC1rZXktMDAwMDAwMDE=
# only needed when PROVIDER=plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US
PLAID_PRODUCTS=transactions
